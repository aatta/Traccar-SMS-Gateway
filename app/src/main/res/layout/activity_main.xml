<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Traccar SMS Gateway"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Server Configuration Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Server Configuration"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Traccar Host -->
        <EditText
            android:id="@+id/editTraccarHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Traccar Server IP/Domain"
            android:text="192.168.1.100"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <!-- Traccar Port -->
        <EditText
            android:id="@+id/editTraccarPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Traccar Server Port"
            android:text="5078"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <!-- Enable Gateway Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enable Gateway"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Auto Start Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Auto Start on Boot"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchAutoStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Device Mapping Section Header & Add Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Device Mapping"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonAddDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add Device"
                style="?android:attr/buttonStyleSmall" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mapped phone numbers to Traccar device IDs:"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="8dp" />

        <!-- Dynamic Container for Mapped Device Cards/Items -->
        <LinearLayout
            android:id="@+id/containerDeviceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- Empty state placeholder text -->
            <TextView
                android:id="@+id/textEmptyDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No devices mapped yet. Tap '+ Add Device' above."
                android:textSize="13sp"
                android:textColor="@android:color/darker_gray"
                android:padding="12dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/buttonSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save Settings"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/buttonTest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Test Connection"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Navigation Screens Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/buttonViewSmsList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SMS Messages DB"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/buttonViewLogs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="System Logs"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Status -->
        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Ready"
            android:textSize="12sp"
            android:padding="12dp"
            android:background="@android:color/darker_gray"
            android:textColor="@android:color/white" />

        <!-- Instructions -->
        <TextView
            android:id="@+id/textInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instructions:\n1. Enter your Traccar server IP and port (default 5078)\n2. Add device mappings for tracker phone numbers\n3. Enable gateway and tap Save Settings\n4. Test connection to verify\n5. Place Android device on network - it will automatically forward incoming tracker SMS to Traccar"
            android:textSize="11sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="24dp"
            android:padding="12dp"
            android:background="@drawable/info_background" />

    </LinearLayout>

</ScrollView>